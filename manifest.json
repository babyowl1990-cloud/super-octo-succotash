{
  "manifest_version": 3,
  "name": "AutoFix Spelling",
  "version": "0.4.0",
  "description": "Fixes spelling & grammar as you type \u2014 offline. Squiggles on every field, click-to-fix, snippets, optional AI rewrite with any API key.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "AutoFix Spelling",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "shared.js",
        "speller.js",
        "engine.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "dict/words.txt",
        "dict/freq.txt"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "optional_host_permissions": [
    "<all_urls>"
  ]
}